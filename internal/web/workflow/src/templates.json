        "name": "Scheduled repository task",
        "repository": "example/repository",
        "enabled": false,
        "includeBacklog": false,
        "trigger": {
          "event": "schedule",
          "intervalHours": 24
        },
        "filters": {
          "mode": "all",
          "rules": []
        },
        "task": {
          "kind": "implement",
          "instructions": "Run the requested repository maintenance task.",
