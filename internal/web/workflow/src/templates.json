{
  "version": 1,
  "workflowVersion": 2,
  "templates": [
    {
      "id": "implement",
      "definition": {
        "id": "implement",
        "name": "Implement issues",
        "repository": "example/repository",
        "enabled": false,
        "includeBacklog": false,
        "trigger": {
          "event": "issue.labeled",
          "value": "ready-for-agent"
        },
        "filters": {
          "mode": "all",
          "rules": []
        },
        "task": {
          "kind": "implement",
          "instructions": "Implement the issue and run the relevant tests.",
          "assignCreator": false,
          "issueLinkMode": "reference",
          "draft": false
        },
        "reviewCycles": 0,
        "merge": {
          "enabled": false,
          "method": "squash",
          "requireApproval": true,
          "deleteBranch": false
        },
        "positions": {}
      },
      "name": "Implement issues",
      "description": "Run an agent when an issue receives the ready-for-agent label."
    },
    {
      "id": "review",
      "definition": {
        "id": "review",
        "name": "Review pull requests",
        "repository": "example/repository",
        "enabled": false,
        "includeBacklog": false,
        "trigger": {
          "event": "pr.review_requested",
          "value": "@me"
        },
        "filters": {
          "mode": "all",
          "rules": []
        },
        "task": {
          "kind": "review",
          "instructions": "Review the pull request for correctness, regressions, and missing tests.",
          "assignCreator": false,
          "issueLinkMode": "reference",
          "draft": false
        },
        "reviewCycles": 0,
        "merge": {
          "enabled": false,
          "method": "squash",
          "requireApproval": true,
          "deleteBranch": false
        },
        "positions": {}
      },
      "name": "Review PRs",
      "description": "Review pull requests when your GitHub account is requested as a reviewer."
    },
    {
