          "event": "pr.checks_failed",
          "value": ""
        },
        "filters": {
          "mode": "all",
          "rules": []
        },
        "task": {
          "kind": "repair",
          "instructions": "Read the failed checks and review feedback, fix the root cause, and run the relevant tests.",
